# 环境变量配置示例
# 数据库连接信息
# SQLite示例
DATABASE_URL="sqlite:///./sakura.db"
# MySQL示例
# DATABASE_URL="mysql+pymysql://username:password@localhost:3306/sakura_db"

# 用于JWT签名的密钥（生产环境请使用强随机字符串）
SECRET_KEY="your-secret-key-here-change-in-production"

# 应用配置
APP_NAME="Sakura Comic API"
APP_VERSION="1.0.0"
DEBUG=True